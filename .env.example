APP_ENV=development
HTTP_ADDR=:8080
MYSQL_DSN=root:password@tcp(127.0.0.1:3306)/feed_videos?parseTime=true&charset=utf8mb4&loc=Local
STORAGE_DIR=./storage
JWT_SECRET=change-me-in-local-env

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
VIDEO_DETAIL_CACHE_TTL=10m
RATE_LIMIT_WINDOW=1m

RABBITMQ_URL=amqp://feed:feed@127.0.0.1:5672/
RABBITMQ_EXCHANGE=feed.events
RABBITMQ_QUEUE=feed.events
RABBITMQ_ROUTING_KEY=feed.event
RABBITMQ_RETRY_QUEUE=feed.events.retry
RABBITMQ_DEAD_LETTER_QUEUE=feed.events.dlq
RABBITMQ_COMMAND_EXCHANGE=feed.interaction.commands
RABBITMQ_LIKE_ROUTING_KEY=interaction.command.like
RABBITMQ_COMMENT_ROUTING_KEY=interaction.command.comment
RABBITMQ_LIKE_QUEUE=interaction.command.like.queue
RABBITMQ_COMMENT_QUEUE=interaction.command.comment.queue
RABBITMQ_COMMAND_RETRY_QUEUE=interaction.command.retry
RABBITMQ_COMMAND_DLQ=interaction.command.dlq
RABBITMQ_COMMAND_RETRY_TTL=30s
RABBITMQ_COMMAND_PREFETCH=16
RABBITMQ_CONFIRM_TIMEOUT=3s
IDEMPOTENCY_TTL=24h
INTERACTION_MARKER_TTL=168h
SCHEDULER_LOCK_TTL=15s
SCHEDULER_LOCK_RENEW_INTERVAL=5s
SCHEDULER_CATCH_UP_LIMIT=10

MYSQL_DATABASE=feed_videos
MYSQL_ROOT_PASSWORD=password
RABBITMQ_DEFAULT_USER=feed
RABBITMQ_DEFAULT_PASS=feed
